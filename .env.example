# GitHub Personal Access Token
# Fine-grained 토큰 권장: 대상 repo 하나만 선택, Repository permissions → Contents: Read and write
GITHUB_TOKEN=

# 용어가 저장될 public repo (github.com/{GITHUB_OWNER}/{GITHUB_REPO})
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
# repo 안의 디렉토리 (앞뒤 슬래시 없이)
TERMS_DIR=terms

# 쓰기(등록/태그 추가) 로그인 비밀번호. 바꾸면 기존 로그인은 모두 풀린다.
ADMIN_PASSWORD=
