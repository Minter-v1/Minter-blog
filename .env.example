# GitHub Personal Access Token
# Fine-grained 토큰 권장: 대상 repo 하나만 선택, Repository permissions → Contents: Read and write
GITHUB_TOKEN=

# 기록(md)이 저장될 데이터 전용 public repo (github.com/{GITHUB_OWNER}/{GITHUB_REPO})
# 앱 코드 repo와는 따로 둔다. 컬렉션마다 폴더: terms/, git/, troubleshooting/
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
# 쓰기(등록/태그 추가) 로그인 비밀번호. 바꾸면 기존 로그인은 모두 풀린다.
ADMIN_PASSWORD=
