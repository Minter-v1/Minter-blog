# GitHub Personal Access Token
# Fine-grained 토큰 권장: 대상 repo 하나만 선택, Repository permissions → Contents: Read and write
GITHUB_TOKEN=

# 기록(md)이 저장될 데이터 전용 public repo (github.com/{GITHUB_OWNER}/{GITHUB_REPO})
# 앱 코드 repo와는 따로 둔다. 컬렉션마다 폴더: terms/, git/, troubleshooting/
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
# 쓰기(등록/태그 추가) 로그인 (#118)
# 비밀번호 해시: `npm run hash-password`로 만든 한 줄 (scrypt:...). 원문은 어디에도 저장하지 않는다
ADMIN_PASSWORD_HASH=
# 로그인 세션 쿠키 서명 키: `openssl rand -base64 32` 같은 긴 랜덤 문자열. 바꾸면 기존 로그인은 모두 풀린다
SESSION_SECRET=
# (예전 방식) 비밀번호 원문. ADMIN_PASSWORD_HASH가 있으면 쓰지 않는다. 옮긴 뒤 지운다
# ADMIN_PASSWORD=

# ---- 오늘 정리한 기록 리마인드 메일 (매일 밤 10시대, vercel.json crons) ----
# Vercel Cron이 Authorization 헤더로 보내는 값. 아무도 못 부르도록 긴 랜덤 문자열
CRON_SECRET=
# resend.com → API Keys (Sending access)
RESEND_API_KEY=
# 받을 메일 주소 (도메인 인증 전엔 Resend 가입 메일만 가능)
REMIND_TO=
# 보내는 주소 (선택). 도메인 인증 후 예: Minter.log <noreply@minter-v1.com>
REMIND_FROM=
# 메일 속 링크 주소 (선택, 기본은 요청 주소)
SITE_URL=https://www.minter-v1.com
